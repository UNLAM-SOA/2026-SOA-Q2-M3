    {
        "id": "func_remoto_cooler",
        "type": "function",
        "z": "b76378b697bed2cd",
        "name": "Control Cooler HTTP",
        "func": "const comando = String(msg.payload?.cooler || \"\").trim().toLowerCase();\n\nif (comando !== \"on\" && comando !== \"auto\") {\n    msg.statusCode = 400;\n    msg.payload = { error: \"El campo 'cooler' debe ser 'on' o 'auto'.\" };\n    return [null, msg];\n}\n\nconst msgMqtt = {\n    topic: \"control/cooler\",\n    payload: JSON.stringify({ cooler: comando })\n};\n\nmsg.statusCode = 200;\nmsg.payload = { ok: true, cooler: comando };\nreturn [msgMqtt, msg];",
