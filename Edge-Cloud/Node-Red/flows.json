    {
        "id": "dcc36491def4c5be",
        "type": "function",
        "z": "b76378b697bed2cd",
        "name": "select tarjeta",
        "func": "const hash = msg.payload?.hash;\n\nif (typeof hash !== \"string\" || !hash.trim()) {\n    msg.topic = \"acceso/tarjeta/respuesta\";\n    msg.payload = JSON.stringify({\n        error: \"Falta el hash de la tarjeta\"\n    });\n    return [null, msg];\n}\n\n// NUEVO: Guardamos el hash intacto en una variable segura para usarlo luego\nmsg.hash_original = hash.trim();\n\nmsg.query = `\n    SELECT\n        u.id_usuario,\n        u.nombre_usuario,\n        u.estado,\n        t.id_tarjeta,\n        t.hash_tarjeta\n    FROM tarjetas_rfid t\n    JOIN usuarios u ON u.id_usuario = t.id_usuario\n    WHERE t.hash_tarjeta = $1\n`;\n\nmsg.params = [hash.trim()];\nmsg.topic = \"acceso/tarjeta/respuesta\";\n\nreturn [msg, null];",
