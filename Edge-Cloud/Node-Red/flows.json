    {
        "id": "func_guardar_clima",
        "type": "function",
        "z": "b76378b697bed2cd",
        "name": "Guardar Clima",
        "func": "let datos = msg.payload;\nif (typeof datos === \"string\") {\n    try {\n        datos = JSON.parse(datos);\n    } catch (e) {\n        return null;\n    }\n}\n\nconst temp = Number(datos.temperatura);\nconst hum = Number(datos.humedad);\nconst coolerManual = global.get(\"cooler_manual\") === true;\n\nif (!isNaN(temp) && !isNaN(hum)) {\n    const fechaArgentina = new Date(Date.now() - (3 * 60 * 60 * 1000)).toISOString();\n\n    global.set(\"ultimo_clima\", {\n        temperatura: temp,\n        humedad: hum,\n        cooler_activo: coolerManual || (temp > 30.0),\n        cooler_manual: coolerManual,\n        timestamp: fechaArgentina\n    });\n}\nreturn null;",
        "outputs": 0,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 920,
        "wires": []
