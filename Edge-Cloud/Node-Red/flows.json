        "name": "Cambiar Estado",
        "func": "const id_usuario = Number(msg.payload.id_usuario);\nconst estado = Boolean(msg.payload.estado);\n\nmsg.query = `\n    UPDATE usuarios\n    SET estado = $2\n    WHERE id_usuario = $1\n    RETURNING id_usuario, nombre_usuario, estado;\n`;\nmsg.params = [id_usuario, estado];\nreturn msg;",
