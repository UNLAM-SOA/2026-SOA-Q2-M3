    {
        "id": "func_post_tarjetas",
        "type": "function",
        "z": "b76378b697bed2cd",
        "name": "Alta Usuario y RFID",
        "func": "const nombre = (msg.payload.nombre_usuario || \"\").trim();\nconst hash = (msg.payload.hash_tarjeta || \"\").trim().toLowerCase();\n\nif (!nombre || !hash) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"Faltan datos obligatorios\" };\n    return [null, msg];\n}\n\nmsg.query = `\n    WITH u AS (\n        INSERT INTO usuarios (nombre_usuario, estado)\n        VALUES ($1, true)\n        ON CONFLICT (nombre_usuario) DO UPDATE SET estado = true\n        RETURNING id_usuario\n    )\n    INSERT INTO tarjetas_rfid (id_usuario, hash_tarjeta)\n    VALUES ((SELECT id_usuario FROM u), $2)\n    ON CONFLICT (hash_tarjeta) DO UPDATE SET id_usuario = (SELECT id_usuario FROM u)\n    RETURNING id_tarjeta, hash_tarjeta;\n`;\nmsg.params = [nombre, hash];\nreturn [msg, null];",
        "outputs": 2,
        "x": 350,
        "y": 1140,
        "wires": [
            [
                "pg_exec_app"
            ],
            [
                "http_resp_app"
            ]
        ]
    },
