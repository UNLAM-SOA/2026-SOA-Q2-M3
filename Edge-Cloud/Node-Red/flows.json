    {
        "id": "func_guardar_cooler",
        "type": "function",
        "z": "b76378b697bed2cd",
        "name": "Estado Cooler Manual",
        "func": "let datos = msg.payload;\nif (typeof datos === \"string\") {\n    try {\n        datos = JSON.parse(datos);\n    } catch (e) {\n        return null;\n    }\n}\n\nconst comando = String(datos?.cooler || \"\").trim().toLowerCase();\nif (comando !== \"on\" && comando !== \"auto\") {\n    return null;\n}\n\nconst esManual = (comando === \"on\");\nglobal.set(\"cooler_manual\", esManual);\n\nconst climaActual = global.get(\"ultimo_clima\") || {\n    temperatura: 0.0,\n    humedad: 0.0,\n    cooler_activo: false,\n    timestamp: null\n};\n\nclimaActual.cooler_manual = esManual;\nclimaActual.cooler_activo = esManual || (Number(climaActual.temperatura) > 30.0);\nglobal.set(\"ultimo_clima\", climaActual);\n\nmsg.payload = {\n    comando_recibido: comando,\n    cooler_manual: esManual,\n    cooler_activo: climaActual.cooler_activo\n};\nreturn msg;",
