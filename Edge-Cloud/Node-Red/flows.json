    {
        "id": "d07564b843482e4c",
        "type": "function",
        "z": "b76378b697bed2cd",
        "name": "insert acceso",
        "func": "const datos = msg.payload;\n\nmsg.query = `\n    INSERT INTO accesos (\n        id_tarjeta,\n        hash_tarjeta,\n        timestamp_acceso,\n        estado_autorizacion\n    )\n    VALUES (\n        (SELECT id_tarjeta FROM tarjetas_rfid WHERE hash_tarjeta = $1),\n        $1, $2, $3\n    )\n    RETURNING id_acceso;\n`;\n\nmsg.params = [\n    datos.hash_tarjeta.trim(),\n    datos.timestamp_acceso,\n    datos.estado_autorizacion\n];\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
