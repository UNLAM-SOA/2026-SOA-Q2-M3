    {
        "id": "bd73efe3c54997d3",
        "type": "function",
        "z": "b76378b697bed2cd",
        "name": "validar tarjeta",
        "func": "const filas = msg.payload;\n\nif (!Array.isArray(filas) || filas.length === 0) {\n    msg.statusCode = 404;\n    msg.payload = {\n        error: \"No existe una tarjeta registrada con ese hash.\"\n    };\n    return msg;\n}\n\nmsg.statusCode = 200;\nmsg.payload = filas[0];\n\nreturn msg;",
