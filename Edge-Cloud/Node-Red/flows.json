        "type": "function",
        "z": "b76378b697bed2cd",
        "name": "select tarjeta",
        "func": "const hash = msg.req.query.hash;\n\nif (typeof hash !== \"string\" || !hash.trim()) {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Debes enviar el parámetro hash.\"\n    };\n    return [null, msg];\n}\n\nmsg.query = `\n    SELECT\n        u.id_usuario,\n        u.nombre_usuario,\n        u.estado,\n        t.id_tarjeta,\n        t.hash_tarjeta\n    FROM tarjetas_rfid t\n    JOIN usuarios u\n        ON u.id_usuario = t.id_usuario\n    WHERE t.hash_tarjeta = $1 AND u.estado = true\n`;\n\nmsg.params = [hash.trim()];\n\nreturn [msg, null];",
