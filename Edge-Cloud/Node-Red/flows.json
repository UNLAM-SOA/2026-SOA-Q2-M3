    {
        "id": "84c17609ae395b36",
        "type": "function",
        "z": "b76378b697bed2cd",
        "name": "Persiste",
        "func": "// 1. Forzamos los headers para que tu API interna lo lea bien\nmsg.headers = { \"Content-Type\": \"application/json\" };\n\n// 2. Leemos la respuesta que armó el nodo anterior\nlet respuesta_mqtt = JSON.parse(msg.payload);\n\n// 3. Recuperamos el hash que salvamos al principio\nlet hash = msg.hash_original || \"desconocido\";\n\n// 4. Si el JSON que va al ESP32 tiene \"error\", el acceso es denegado\nlet estado = respuesta_mqtt.error ? \"NO_AUTORIZADO\" : \"AUTORIZADO\";\n\n// 5. Armamos el body para el POST\nmsg.payload = {\n    \"hash_tarjeta\": hash,\n    \"timestamp_acceso\": new Date().toISOString(),\n    \"estado_autorizacion\": estado\n};\n\nreturn msg;",
