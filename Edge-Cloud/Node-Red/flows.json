        "query": "SELECT\n    a.id_acceso,\n    a.hash_tarjeta,\n    a.timestamp_acceso,\n    a.estado_autorizacion,\n    u.id_usuario,\n    u.nombre_usuario\nFROM accesos a\nLEFT JOIN tarjetas_rfid t\n    ON t.id_tarjeta = a.id_tarjeta\nLEFT JOIN usuarios u\n    ON u.id_usuario = t.id_usuario\nORDER BY a.id_acceso DESC;",
